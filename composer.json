{
    "name": "techtrain/coupling-meter",
    "description": "Measure coupling balance (strength, distance, volatility) of a PHP project",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "coupling",
        "modularity",
        "static-analysis",
        "git",
        "balanced-coupling"
    ],
    "homepage": "https://github.com/TechBowl-japan/coupling-meter",
    "authors": [
        {
            "name": "Takuma Kajikawa",
            "email": "kj1ktk@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/TechBowl-japan/coupling-meter/issues",
        "source": "https://github.com/TechBowl-japan/coupling-meter"
    },
    "require": {
        "php": ">=8.2",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "Techtrain\\CouplingMeter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Techtrain\\CouplingMeter\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/coupling-meter"
    ],
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs-fix": "php-cs-fixer fix --verbose",
        "cs-check": "php-cs-fixer fix --verbose --dry-run",
        "check": [
            "@phpstan",
            "@cs-check",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
