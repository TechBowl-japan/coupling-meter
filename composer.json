{
    "name": "valbeat/php-coupling",
    "description": "Measure coupling balance (strength, distance, volatility) of a PHP project",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "nikic/php-parser": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Valbeat\\PhpCoupling\\": "src/"
        }
    },
    "bin": [
        "bin/php-coupling"
    ],
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload-dev": {
        "psr-4": {
            "Valbeat\\PhpCoupling\\Tests\\": "tests/"
        }
    }
}
