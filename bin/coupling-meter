#!/usr/bin/env php
<?php

declare(strict_types=1);

use Techtrain\CouplingMeter\Balance\ModuleMap;
use Techtrain\CouplingMeter\Balance\Pair;
use Techtrain\CouplingMeter\Config\CodeOwners;
use Techtrain\CouplingMeter\Config\Options;
use Techtrain\CouplingMeter\Config\Packages;
use Techtrain\CouplingMeter\Config\Presets;
use Techtrain\CouplingMeter\Config\Rules;
use Techtrain\CouplingMeter\History\GitHistory;
use Techtrain\CouplingMeter\Report\Annotations;
use Techtrain\CouplingMeter\Report\BalanceReport;
use Techtrain\CouplingMeter\Report\Baseline;
use Techtrain\CouplingMeter\Source\Analyzer;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (file_exists($autoload)) {
        require $autoload;

        break;
    }
}

try {
    $options = Options::parse(array_slice($argv, 1));
} catch (\InvalidArgumentException $e) {
    fwrite(STDERR, $e->getMessage() . "\nRun --help for usage.\n");
    exit(1);
}

if ($options->help || $options->path === null) {
    fwrite(STDOUT, <<<TEXT
        coupling-meter — measure the coupling balance of a PHP project

        Usage:
          coupling-meter <path> [--include=app,src] [--exclude=legacy] [--depth=2] [--since="12 months ago"] [--top=15] [--json|--samples]

        Options:
          --depth     how many namespace segments make up one module (default 2)
          --since     how far back to read git history (default "12 months ago")
          --top       how many pairs to display (default 15)
          --include   look only at these directories under root (comma separated)
          --exclude   add excluded directories (comma separated)
          --json      machine-readable JSON output (same as --format=json)
          --samples   representative examples per pair with file and line, meant to be
                      handed to an AI for judgement (same as --format=samples)
          --format    output shape (text / json / samples / github). github emits
                      GitHub Actions annotations
          --fail-on   exit with code 1 if a pair at or below this balance is present
          --baseline  file recording known pairs. Only pairs added or made worse
                      since then are reported
          --write-baseline
                      rewrite the --baseline file from the current measurement and exit
          --rules     allowed dependencies (deptrac.yaml or coupling-meter.yaml).
                      Looks for coupling-meter.yaml / deptrac.yaml / deptrac.config.yaml
                      at root when omitted
          --codeowners
                      ownership declaration (CODEOWNERS). Looks at root, .github,
                      docs and .gitlab when omitted. Takes precedence over git authors
                      when deciding which pairs are owned by different people
          --preset    framework conventions (laravel / symfony / none, comma separated).
                      Guessed from composer.json when omitted. Define your own under
                      presets: in coupling-meter.yaml and call it by name
          --max-commit-files
                      drop commits that touched more than this many analyzed files
                      (default 50, 0 to disable). Bulk reformatting and license updates
                      create co-change between everything while sharing no knowledge
          --split     split namespaces with more classes than this one level deeper
                      (default 0 = never split)
          --weight-by-references
                      weight the ranking by the logarithm of the reference count

        TEXT);
    exit($options->path === null && !$options->help ? 1 : 0);
}

$root = realpath($options->path);
if ($root === false || !is_dir($root)) {
    fwrite(STDERR, "Directory to analyze not found: {$options->path}\n");
    exit(1);
}

try {
    $customPresets = Presets::custom($root, $options->rules);
    $presetNames = $options->presets ?? Presets::detect($root);
    $preset = Presets::resolve($presetNames, $customPresets);
} catch (\InvalidArgumentException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(1);
}

$depth = $options->depth;
$since = $options->since;
$top = $options->top;
$excludes = $options->excludes;
$includes = $options->includes;

$analyzer = new Analyzer($root, $excludes, $includes, $preset);
$analyzer->run();

$git = new GitHistory($root, $since, $options->maxCommitFiles);
$hasGit = $git->load();

try {
    $rules = Rules::discover($root, $options->rules);
    $codeOwners = CodeOwners::discover($root, $options->codeowners);
} catch (\InvalidArgumentException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(1);
}

$modules = ModuleMap::autoSplit($depth, array_keys($analyzer->index()), $options->split);
$report = new BalanceReport($analyzer, $modules, $hasGit ? $git : null, $root, $rules, Packages::fromRoot($root), $options->weightByReferences, $codeOwners);
$report->build();

$pairs = $report->pairs();
$stats = $report->stats();
$findings = $report->findings();

// AI や人が読むための、境界ごとの代表例。コード全体ではなく、組の代表だけを出す。
if ($options->samples) {
    fwrite(STDOUT, "# Coupling boundaries and their representative examples\n\n");
    fwrite(STDOUT, sprintf(
        "%d module pairs, lowest balance first. balance = max(|strength - distance|, 10 - volatility) + 1, where 1 leans furthest toward complexity.\n\n",
        count($pairs),
    ));
    foreach (array_slice($pairs, 0, $top) as $pair) {
        fwrite(STDOUT, sprintf(
            "## %s -> %s\n\nbalance %d / strength %s(%d) / distance %d / volatility %d / %d references / %d%% co-change\n\n",
            $pair->from,
            $pair->to,
            $pair->balance,
            $pair->strength->label(),
            $pair->strengthValue,
            $pair->distanceValue,
            $pair->volatilityValue,
            $pair->references,
            (int) round($pair->coChangeRate * 100),
        ));
        foreach ($pair->samples as $sample) {
            fwrite(STDOUT, sprintf(
                "- %s:%d  %s (%s)  %s -> %s\n    why:  %s\n    next: %s\n",
                $sample['file'],
                $sample['line'],
                $sample['strength'],
                $sample['kind'],
                $sample['from'],
                $sample['to'],
                $sample['why'],
                $sample['next'],
            ));
        }
        fwrite(STDOUT, "\n");
    }
    exit(0);
}

if ($options->json) {
    $payload = [
        'root' => $root,
        'preset' => $preset->name,
        'skipped_commits' => $git->skipped(),
        'stats' => $stats,
        'pairs' => array_map(static function (Pair $pair): array {
            $array = $pair->toArray();
            $array['co_change_rate'] = round($pair->coChangeRate, 3);

            return $array;
        }, $pairs),
        'findings' => $findings,
    ];
    fwrite(STDOUT, json_encode($payload, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n");
    exit(0);
}

// CI 向け。基準からの増分だけを見て、終了コードで知らせる。
if ($options->writeBaseline) {
    if (file_put_contents((string) $options->baseline, Baseline::render($pairs)) === false) {
        fwrite(STDERR, "Cannot write the baseline file: {$options->baseline}\n");
        exit(1);
    }
    fwrite(STDOUT, sprintf("Recorded %d pairs in %s\n", count($pairs), $options->baseline));
    exit(0);
}

$ci = $options->format === 'github' || $options->failOn !== null;
if ($ci) {
    try {
        $baseline = $options->baseline !== null ? Baseline::load($options->baseline) : Baseline::empty();
    } catch (\InvalidArgumentException $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }

    // 基準が無いときは全組が「新しく出た組」になる。--fail-on で足切りする前提。
    $regressions = $baseline->regressions($pairs);
    if ($options->failOn !== null) {
        $regressions = array_values(array_filter(
            $regressions,
            static fn (array $entry): bool => $entry['pair']->balance <= $options->failOn,
        ));
    }

    if ($options->format === 'github') {
        // 注釈は 1 ジョブ 10 件までしか表示されない。残りはまとめの行で数だけ伝える。
        foreach (array_slice($regressions, 0, 10) as $entry) {
            fwrite(STDOUT, Annotations::forRegression($entry, $root) . "\n");
        }
    } else {
        foreach ($regressions as $entry) {
            $pair = $entry['pair'];
            fwrite(STDOUT, sprintf(
                "  %s  balance %d%s  %s -> %s\n",
                $entry['was'] === null ? 'new  ' : 'worse',
                $pair->balance,
                $entry['was'] === null ? '' : sprintf(' (was %d)', $entry['was']),
                $pair->from,
                $pair->to,
            ));
        }
    }

    // モジュールが 1 つしかないと組は 0 件になる。測れていないことを緑で通さない。
    if ($pairs === []) {
        fwrite(STDERR, sprintf(
            "Nothing to measure (%d module, 0 pairs). A project with a single namespace produces no pairs. Review --depth.\n",
            $stats['modules'],
        ));
        exit(2);
    }

    fwrite(STDOUT, sprintf(
        "%s%d pairs / %d added since the baseline%s\n",
        $options->format === 'github' ? '' : "\n",
        count($pairs),
        count($regressions),
        $options->failOn === null ? '' : sprintf(' (at balance %d or below)', $options->failOn),
    ));

    exit($options->failOn !== null && $regressions !== [] ? 1 : 0);
}

$bold = static fn (string $text): string => "\033[1m{$text}\033[0m";
$dim = static fn (string $text): string => "\033[2m{$text}\033[0m";

fwrite(STDOUT, "\n" . $bold('coupling-meter') . ' ' . $dim($root) . "\n");
fwrite(STDOUT, sprintf(
    "  classes %d / references %d / modules %d / pairs %d / commits %s%s / preset %s\n\n",
    $stats['classes'],
    $stats['references'],
    $stats['modules'],
    $stats['pairs'],
    match (true) {
        $hasGit => (string) $stats['commits'],
        $git->isRepository() => '— (no commit touched PHP in this window; widen --since)',
        default => '— (no git history)',
    },
    $git->skipped() === 0 ? '' : sprintf(' (%d bulk commits skipped)', $git->skipped()),
    $preset->name,
));

$unbalanced = count(array_filter($pairs, static fn (Pair $pair): bool => !$pair->balanced));
fwrite(STDOUT, sprintf(
    "  unbalanced pairs: %d / %d\n\n",
    $unbalanced,
    count($pairs),
));

fwrite(STDOUT, $bold('Fix in this order') . $dim(' (lowest balance first: max(|strength - distance|, 10 - volatility) + 1)') . "\n");
fwrite(STDOUT, sprintf("  %4s  %-10s %4s %4s %4s %7s  %s\n", 'BAL', 'STRENGTH', 'STR', 'DIST', 'VOL', 'CO-CHG', 'MODULE PAIR'));

foreach (array_slice($pairs, 0, $top) as $pair) {
    fwrite(STDOUT, sprintf(
        "  %4d  %-10s %4d %4d %4d %6s%%  %s -> %s\n",
        $pair->balance,
        $pair->strength->label(),
        $pair->strengthValue,
        $pair->distanceValue,
        $pair->volatilityValue,
        $hasGit ? (string) (int) round($pair->coChangeRate * 100) : '—',
        $pair->from,
        $pair->to,
    ));
}

if ($findings !== []) {
    $labels = [
        'mutual' => 'mutual dependency',
        'inverted' => 'inverted dependency',
        'tight-coupling' => 'high strength and distance',
        'low-cohesion' => 'close but unrelated',
        'hidden' => "coupling types don't show",
        'string-reference' => 'dependency written as a string',
        'split-ownership' => 'different people touch it',
        'inherited-volatility' => "inheriting the other side's volatility",
        'intrusive-and-moving' => 'intrusive and moving',
    ];
    fwrite(STDOUT, "\n" . $bold('Findings') . "\n");
    foreach (array_slice($findings, 0, $top) as $finding) {
        fwrite(STDOUT, sprintf("  [%s] %s\n      %s\n", $labels[$finding['type']], $finding['pair'], $finding['detail']));
    }
}

$changeKinds = $report->changeKinds();
if ($changeKinds !== []) {
    $rows = [];
    foreach ($changeKinds as $module => $kinds) {
        $classified = ($kinds['Evolution'] ?? 0) + ($kinds['Correction'] ?? 0) + ($kinds['Maintenance'] ?? 0);
        if ($classified < 10) {
            continue;
        }
        $rows[$module] = [
            'ratio' => ($kinds['Evolution'] ?? 0) / $classified,
            'evolution' => $kinds['Evolution'] ?? 0,
            'correction' => $kinds['Correction'] ?? 0,
            'maintenance' => $kinds['Maintenance'] ?? 0,
        ];
    }
    uasort($rows, static fn (array $a, array $b): int => $b['ratio'] <=> $a['ratio']);

    if ($rows !== []) {
        fwrite(STDOUT, "\n" . $bold('Kinds of change') . $dim(' (share of changes that add features)') . "\n");
        fwrite(STDOUT, "   EVOL%   EVOL    FIX   MAINT  MODULE\n");
        foreach (array_slice($rows, 0, 8, true) as $module => $row) {
            fwrite(STDOUT, sprintf(
                "  %5d%% %6d %6d %6d  %s\n",
                (int) round($row['ratio'] * 100),
                $row['evolution'],
                $row['correction'],
                $row['maintenance'],
                $module,
            ));
        }
    }
}

fwrite(STDOUT, "\n" . $dim('BAL is the balance. 1 leans furthest toward complexity, 10 is the most modular. From section 10.3 of the book.') . "\n");
fwrite(STDOUT, $dim('STR / DIST / VOL are on a 1 to 10 scale. The author notes that this is not an exact science.') . "\n");
fwrite(STDOUT, $dim('DIST comes from the nearest common namespace ancestor, pushed one step apart when the owners differ (CODEOWNERS if declared, otherwise git authors).') . "\n");
fwrite(STDOUT, $dim('VOL is volatility observed from git history. It does not distinguish "changes often because the design is bad" from "nobody dares touch it".') . "\n");
fwrite(STDOUT, $dim('An unbalanced pair is one where BALANCE = (STRENGTH XOR DISTANCE) OR NOT VOLATILITY is false. See balanced per pair in --json.') . "\n\n");
