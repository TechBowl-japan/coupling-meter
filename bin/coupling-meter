#!/usr/bin/env php
<?php

declare(strict_types=1);

use Techtrain\CouplingMeter\Analyzer;
use Techtrain\CouplingMeter\BalanceReport;
use Techtrain\CouplingMeter\GitHistory;
use Techtrain\CouplingMeter\ModuleMap;
use Techtrain\CouplingMeter\Options;
use Techtrain\CouplingMeter\Pair;
use Techtrain\CouplingMeter\Rules;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (file_exists($autoload)) {
        require $autoload;

        break;
    }
}

try {
    $options = Options::parse(array_slice($argv, 1));
} catch (\InvalidArgumentException $e) {
    fwrite(STDERR, $e->getMessage() . "\n--help で使い方を表示します。\n");
    exit(1);
}

if ($options->help || $options->path === null) {
    fwrite(STDOUT, <<<TEXT
        coupling-meter — PHP プロジェクトの結合バランスを測る

        使い方:
          coupling-meter <path> [--include=app,src] [--exclude=legacy] [--depth=2] [--since="12 months ago"] [--top=15] [--json|--samples]

        オプション:
          --depth     名前空間の何段目までを 1 モジュールとするか（既定 2）
          --since     git 履歴をさかのぼる範囲（既定 "12 months ago"）
          --top       表示する組の数（既定 15）
          --include   解析対象を root 直下のディレクトリに限定する（カンマ区切り）
          --exclude   除外ディレクトリをカンマ区切りで追加
          --json      機械可読な JSON で出力する
          --samples   組ごとの代表例をファイルと行つきで出す（AI に渡して判断させる用）
          --rules     意図した依存の許可ルール（deptrac.yaml か coupling-meter.yaml）。
                      省略時は root の coupling-meter.yaml / deptrac.yaml / deptrac.config.yaml を探す

        TEXT);
    exit($options->path === null && !$options->help ? 1 : 0);
}

$root = realpath($options->path);
if ($root === false || !is_dir($root)) {
    fwrite(STDERR, "解析対象のディレクトリが見つかりません: {$options->path}\n");
    exit(1);
}

$depth = $options->depth;
$since = $options->since;
$top = $options->top;
$excludes = $options->excludes;
$includes = $options->includes;

$analyzer = new Analyzer($root, $excludes, $includes);
$analyzer->run();

$git = new GitHistory($root, $since);
$hasGit = $git->load();

try {
    $rules = Rules::discover($root, $options->rules);
} catch (\InvalidArgumentException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(1);
}

$report = new BalanceReport($analyzer, new ModuleMap($depth), $hasGit ? $git : null, $root, $rules);
$report->build();

$pairs = $report->pairs();
$stats = $report->stats();
$findings = $report->findings();

// AI や人が読むための、境界ごとの代表例。コード全体ではなく、組の代表だけを出す。
if ($options->samples) {
    fwrite(STDOUT, "# 結合の境界と、その代表例\n\n");
    fwrite(STDOUT, sprintf(
        "モジュールの組 %d 件。均衡度の低い順。均衡度は max(|強度 - 距離|, 10 - 変動性) + 1 で、1 が最も複雑性に傾く。\n\n",
        count($pairs),
    ));
    foreach (array_slice($pairs, 0, $top) as $pair) {
        fwrite(STDOUT, sprintf(
            "## %s -> %s\n\n均衡度 %d / 強度 %s(%d) / 距離 %d / 変動性 %d / 参照 %d 箇所 / 同時変更 %d%%\n\n",
            $pair->from,
            $pair->to,
            $pair->balance,
            $pair->strength->label(),
            $pair->strengthValue,
            $pair->distanceValue,
            $pair->volatilityValue,
            $pair->references,
            (int) round($pair->coChangeRate * 100),
        ));
        foreach ($pair->samples as $sample) {
            fwrite(STDOUT, sprintf(
                "- %s:%d  %s（%s）  %s -> %s\n",
                $sample['file'],
                $sample['line'],
                $sample['strength'],
                $sample['kind'],
                $sample['from'],
                $sample['to'],
            ));
        }
        fwrite(STDOUT, "\n");
    }
    exit(0);
}

if ($options->json) {
    $payload = [
        'root' => $root,
        'stats' => $stats,
        'pairs' => array_map(static function (Pair $pair): array {
            $array = $pair->toArray();
            $array['co_change_rate'] = round($pair->coChangeRate, 3);

            return $array;
        }, $pairs),
        'findings' => $findings,
    ];
    fwrite(STDOUT, json_encode($payload, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n");
    exit(0);
}

$bold = static fn (string $text): string => "\033[1m{$text}\033[0m";
$dim = static fn (string $text): string => "\033[2m{$text}\033[0m";

fwrite(STDOUT, "\n" . $bold('coupling-meter') . ' ' . $dim($root) . "\n");
fwrite(STDOUT, sprintf(
    "  クラス %d / 参照 %d / モジュール %d / 組 %d / 解析コミット %s\n\n",
    $stats['classes'],
    $stats['references'],
    $stats['modules'],
    $stats['pairs'],
    match (true) {
        $hasGit => (string) $stats['commits'],
        $git->isRepository() => '—（期間内に PHP を触ったコミットなし。--since を広げると出る）',
        default => '—（git 履歴なし）',
    },
));

$unbalanced = count(array_filter($pairs, static fn (Pair $pair): bool => !$pair->balanced));
fwrite(STDOUT, sprintf(
    "  バランスが崩れている組: %d / %d\n\n",
    $unbalanced,
    count($pairs),
));

fwrite(STDOUT, $bold('直す順') . $dim('（均衡度の低い順。max(|強度 - 距離|, 10 - 変動性) + 1）') . "\n");
fwrite(STDOUT, sprintf("  %4s  %-10s %4s %4s %4s %7s  %s\n", 'BAL', 'STRENGTH', 'STR', 'DIST', 'VOL', 'CO-CHG', 'MODULE PAIR'));

foreach (array_slice($pairs, 0, $top) as $pair) {
    fwrite(STDOUT, sprintf(
        "  %4d  %-10s %4d %4d %4d %6s%%  %s -> %s\n",
        $pair->balance,
        $pair->strength->label(),
        $pair->strengthValue,
        $pair->distanceValue,
        $pair->volatilityValue,
        $hasGit ? (string) (int) round($pair->coChangeRate * 100) : '—',
        $pair->from,
        $pair->to,
    ));
}

if ($findings !== []) {
    $labels = [
        'mutual' => '互いに依存',
        'inverted' => '逆転済みの依存',
        'tight-coupling' => '強度も距離も高い',
        'low-cohesion' => '近いのに関係が薄い',
        'hidden' => '型に出ない結合',
        'string-reference' => '文字列で書かれた依存',
        'split-ownership' => '触っている人が分かれている',
        'inherited-volatility' => '相手の変動性をもらっている',
        'intrusive-and-moving' => '踏み込んだ依存が動いている',
    ];
    fwrite(STDOUT, "\n" . $bold('指摘') . "\n");
    foreach (array_slice($findings, 0, $top) as $finding) {
        fwrite(STDOUT, sprintf("  [%s] %s\n      %s\n", $labels[$finding['type']], $finding['pair'], $finding['detail']));
    }
}

$changeKinds = $report->changeKinds();
if ($changeKinds !== []) {
    $rows = [];
    foreach ($changeKinds as $module => $kinds) {
        $classified = ($kinds['Evolution'] ?? 0) + ($kinds['Correction'] ?? 0) + ($kinds['Maintenance'] ?? 0);
        if ($classified < 10) {
            continue;
        }
        $rows[$module] = [
            'ratio' => ($kinds['Evolution'] ?? 0) / $classified,
            'evolution' => $kinds['Evolution'] ?? 0,
            'correction' => $kinds['Correction'] ?? 0,
            'maintenance' => $kinds['Maintenance'] ?? 0,
        ];
    }
    uasort($rows, static fn (array $a, array $b): int => $b['ratio'] <=> $a['ratio']);

    if ($rows !== []) {
        fwrite(STDOUT, "\n" . $bold('変更の中身') . $dim('（機能を足す変更が占める割合）') . "\n");
        fwrite(STDOUT, "  進化率   進化   修正   整備  MODULE\n");
        foreach (array_slice($rows, 0, 8, true) as $module => $row) {
            fwrite(STDOUT, sprintf(
                "  %5d%% %6d %6d %6d  %s\n",
                (int) round($row['ratio'] * 100),
                $row['evolution'],
                $row['correction'],
                $row['maintenance'],
                $module,
            ));
        }
    }
}

fwrite(STDOUT, "\n" . $dim('BAL は均衡度。1 が最も複雑性に傾き、10 が最もモジュラー。原著 10.3 の式による。') . "\n");
fwrite(STDOUT, $dim('STR / DIST / VOL は 1 から 10 の目盛り。著者は「これは正確な科学ではない」と断っている。') . "\n");
fwrite(STDOUT, $dim('DIST は名前空間の共通の祖先から出し、触っている人が分かれている組は 1 段遠くしている。') . "\n");
fwrite(STDOUT, $dim('VOL は git 履歴から観測した変動性。設計が悪くて頻繁に変わっている場合と、危険で触れていない場合を区別しない。') . "\n");
fwrite(STDOUT, $dim('「バランスが崩れている組」は BALANCE = (STRENGTH XOR DISTANCE) OR NOT VOLATILITY が偽になる組。--json の balanced で組ごとに見られる。') . "\n\n");
